{
  "name": "public-budget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build",
    "preview": "wrangler dev --config wrangler.jsonc --port 8787",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "setup": "node scripts/setup.mjs",
    "deploy": "npm run build && wrangler deploy --config wrangler.production.jsonc",
    "test:api": "node scripts/check-server.mjs",
    "format": "prettier --write src shared worker tests scripts *.json *.ts",
    "restore:prepare": "tsx scripts/restore.ts",
    "prebuild": "node scripts/build-icon-catalog.mjs && node scripts/build-payee-logo-catalog.mjs",
    "import:prepare:goodbudget": "tsx scripts/prepare-goodbudget-history.ts"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "idb": "^8.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "motion": "^14.0.0",
    "papaparse": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0",
    "ws": "^8.22.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
