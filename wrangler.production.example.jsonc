{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "CHANGE-ME-budget",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "CHANGE-ME-budget",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "BudgetLive" }],
  },
  "migrations": [{ "tag": "live-v1", "new_sqlite_classes": ["BudgetLive"] }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "PLAID_ENV": "production", "PLAID_REFRESH_ENABLED": "true", "PLAID_WEBHOOK_URL": "https://CHANGE-ME.workers.dev/api/plaid/webhook" },
}
